#!/usr/bin/env bash
# Per-monitor random wallpaper rotation via swww.
# Each invocation toggles the rotation loop on/off (cache-flag pattern).
#
#   - Picks a fresh random image per output on every tick
#   - Updates ~/.config/background to whichever image landed on the primary
#   - Configurable via ~/.config/chatmixd-unrelated wait, env vars below

set -u

INTERVAL_FILE="$HOME/.config/hypr/wallpaper-interval"
WP_DIR="${WP_DIR:-$HOME/Pictures/Wallpapers/anime}"
PRIMARY_OUTPUT="${PRIMARY_OUTPUT:-DP-3}"
CACHE_FLAG="$HOME/.cache/hypr/wallpaper-automation"

mkdir -p "$(dirname "$CACHE_FLAG")"

# Interval (seconds). Falls back to 600 (10 min) if no override.
get_interval() {
    if [[ -r "$INTERVAL_FILE" ]]; then
        cat "$INTERVAL_FILE"
    else
        echo 600
    fi
}

pick_random_image() {
    # Recursively find image files under $WP_DIR; print one absolute path.
    find "$WP_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
        2>/dev/null | shuf -n 1
}

set_per_monitor() {
    local primary_img=""
    local outputs=()
    mapfile -t outputs < <(hyprctl monitors | awk '/^Monitor/{print $2}')
    local n="${#outputs[@]}"

    # Shuffle the whole pool once and consume one image per monitor.
    # Guarantees no duplicates within a single rotation tick, even on small pools.
    local picks=()
    mapfile -t picks < <(
        find "$WP_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
            2>/dev/null | shuf -n "$n"
    )
    if [[ "${#picks[@]}" -lt "$n" ]]; then
        echo ":: not enough images under $WP_DIR (need $n, have ${#picks[@]})" >&2
        return 1
    fi

    local i=0
    for out in "${outputs[@]}"; do
        local img="${picks[$i]}"
        # `fade` is per-output and well-behaved when issued across two outputs
        # back-to-back. `any` rolls random transitions and some of them
        # (e.g. `outer`, `grow`) bleed into the other output, ending up with
        # both monitors on the second image.
        swww img -o "$out" "$img" \
            --transition-type fade \
            --transition-duration 1.5 \
            --transition-fps 60
        [[ "$out" == "$PRIMARY_OUTPUT" ]] && primary_img="$img"
        i=$((i + 1))
        # Wait out the full transition before issuing the next `swww img -o`.
        # Overlapping transitions across two outputs cause the second image
        # to override the first on both monitors. 2s (= duration 1.5 + 0.5
        # settle) wasn't reliable; 3s consistently works on this hardware.
        sleep 3
    done

    # Keep ~/.config/background pointing at whatever's on the primary output
    [[ -n "$primary_img" ]] && ln -sfT "$primary_img" "$HOME/.config/background"
}

_loop() {
    local sec
    sec="$(get_interval)"
    while true; do
        set_per_monitor
        echo ":: next rotation in ${sec}s"
        sleep "$sec"
    done
}

if [[ ! -f "$CACHE_FLAG" ]]; then
    touch "$CACHE_FLAG"
    notify-send "Wallpaper rotation started" "Per-monitor random, every $(get_interval)s"
    _loop
else
    rm -f "$CACHE_FLAG"
    notify-send "Wallpaper rotation stopped"
    # Kill the other instance(s) of this script
    pkill -KILL -f "$(basename "$0")" -P 1
fi
