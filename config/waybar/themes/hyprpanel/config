// Waybar theme replicating the retired hyprpanel setup (spec: ~/.config/hyprpanel/config.json)
// Bar 1 = DP-3 (main): dashboard | workspaces | window ... clock ... media vol net bt notif tray
// Bar 2 = DP-4:        workspaces | window ... clock
[
  {
    "output": "DP-3",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "modules-left": ["custom/dashboard", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "pulseaudio", "network", "bluetooth", "custom/notifications", "tray"],

    "custom/dashboard": {
      "format": "",
      "tooltip-format": "App launcher",
      "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
      "max-length": 48,
      "separate-outputs": true
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": { "mode": "month" }
    },
    "mpris": {
      "format": "{player_icon} {artist} - {title}",
      "format-paused": "{status_icon} {artist} - {title}",
      "max-length": 40,
      "player-icons": { "default": "▶" },
      "status-icons": { "paused": "⏸" },
      "on-click": "playerctl play-pause"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 {volume}%",
      "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
      "on-click": "pavucontrol",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "network": {
      "format-wifi": "󰤨",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤭",
      "tooltip-format": "{ifname}: {ipaddr} ({signalStrength}%)",
      "tooltip-format-ethernet": "{ifname}: {ipaddr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
      "interval": 5
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱 {num_connections}",
      "format-disabled": "󰂲",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}"
    },
    "custom/notifications": {
      "tooltip": false,
      "format": "{icon}",
      "format-icons": {
        "notification": "󱅫",
        "none": "󰂚",
        "dnd-notification": "󰂛",
        "dnd-none": "󰂛"
      },
      "return-type": "json",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    },
    "tray": { "spacing": 10 }
  },
  {
    "output": "DP-4",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [],

    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
      "max-length": 40,
      "separate-outputs": true
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    }
  }
]
