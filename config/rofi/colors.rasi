* {
    background: rgba(230, 237, 247, 0.7);
    primary: #8800ff;
    primary-fixed: #6600cc;
    primary-fixed-dim: #8800ff;
    on-primary: #e6edf7;
    on-primary-fixed: #e6edf7;
    on-primary-fixed-variant: #e6edf7;
    primary-container: #6600cc;
    on-primary-container: #e6edf7;
    secondary: #bb88ff;
    secondary-fixed: #bb88ff;
    secondary-fixed-dim: #bb88ff;
    on-secondary: #e6edf7;
    on-secondary-fixed: #e6edf7;
    on-secondary-fixed-variant: #e6edf7;
    secondary-container: #0f172a;
    on-secondary-container: #e6edf7;
    tertiary: #bb88ff;
    tertiary-fixed: #bb88ff;
    tertiary-fixed-dim: #bb88ff;
    on-tertiary: #e6edf7;
    on-tertiary-fixed: #e6edf7;
    on-tertiary-fixed-variant: #e6edf7;
    tertiary-container: #0f172a;
    on-tertiary-container: #e6edf7;
    error: #ff4e66;
    on-error: #601410;
    error-container: #8c1d18;
    on-error-container: #f9dedc;
    surface: #0b0f1a;
    on-surface: #e6edf7;
    on-surface-variant: #cbd5e1;
    outline: #1a1a2e;
    outline-variant: #111827;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f5f5f5;
    inverse-on-surface: #1a1a1a;
    inverse-primary: #8800ff;
    surface-dim: #070b14;
    surface-bright: #162033;
    surface-container-lowest: #070b14;
    surface-container-low: #0b0f1a;
    surface-container: #0a1220;
    surface-container-high: #0f172a;
    surface-container-highest: #162033;
}
