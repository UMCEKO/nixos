// Waybar clone of the user's hyprpanel bar (reference: CachyOS side-by-side screenshot).
[
  {
    "output": "DP-3",
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 8,
    "modules-left": ["custom/dashboard", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["custom/media"],
    "modules-right": ["pulseaudio", "network", "bluetooth", "custom/headset", "tray", "clock", "custom/notifications"],

    "custom/dashboard": {
      "format": "󱄅",
      "tooltip-format": "App launcher",
      "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
      "format": "●",
      "persistent-workspaces": { "*": 10 },
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
      "format": "󰣆  {class}",
      "max-length": 44,
      "separate-outputs": true,
      "rewrite": { "󰣆  \\.(.*)-wrapped": "󰣆  $1", "󰣆  (.*)-wrapped": "󰣆  $1" }
    },
    "custom/media": {
      "format": "<span foreground=\"#cba6f7\">󰝚</span>  {}",
      "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | cut -c1-45 | grep . || echo Media",
      "interval": 3,
      "on-click": "playerctl play-pause"
    },
    "pulseaudio": {
      "format": "<span foreground=\"#f38ba8\">{icon}</span>  {volume}%",
      "format-muted": "<span foreground=\"#f38ba8\">󰝟</span>  {volume}%",
      "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
      "on-click": "pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "network": {
      "format-wifi": "<span foreground=\"#a6e3a1\">󰤨</span>  {essid}",
      "format-ethernet": "<span foreground=\"#a6e3a1\">󰈀</span>  Wired",
      "format-disconnected": "󰤭  Off",
      "tooltip-format": "{ifname}: {ipaddr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
      "on-click": "networkmanager_dmenu",
      "interval": 5
    },
    "bluetooth": {
      "format": "<span foreground=\"#89b4fa\">󰂯</span>  On",
      "format-connected": "<span foreground=\"#89b4fa\">󰂱</span>  {num_connections}",
      "format-disabled": "󰂲  Off",
      "on-click": "rofi-bluetooth",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}"
    },
    "custom/headset": {
      "format": "󰋋  {}",
      "exec": "headsetcontrol -b 2>/dev/null | grep -oE '[0-9]+%' | head -1 || true",
      "interval": 60,
      "exec-if": "headsetcontrol -b >/dev/null 2>&1"
    },
    "tray": { "spacing": 10 },
    "clock": {
      "format": "<span foreground=\"#fab387\">󰃭</span>  {:%a %b %d  %I:%M:%S %p}",
      "interval": 1,
      "on-click": "gsimplecal",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": { "mode": "month" }
    },
    "custom/notifications": {
      "tooltip": false,
      "format": "{icon}",
      "format-icons": {
        "notification": "󱅫",
        "none": "󰂚",
        "dnd-notification": "󰂛",
        "dnd-none": "󰂛"
      },
      "return-type": "json",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    }
  },
  {
    "output": "DP-4",
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 8,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [],

    "hyprland/workspaces": {
      "format": "●",
      "persistent-workspaces": { "*": 10 },
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": { "format": "󰣆  {class}", "max-length": 40, "separate-outputs": true },
    "clock": { "format": "<span foreground=\"#fab387\">󰃭</span>  {:%a %b %d  %I:%M %p}", "tooltip-format": "<tt><small>{calendar}</small></tt>" }
  }
]
